# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.
PLANNER=claude_code                       # fake | claude_code | api
ANTHROPIC_API_KEY=only-needed-when-PLANNER=api
GROQ_API_KEY=put-your-groq-key-here
SHORTSMITH_PASSCODE=choose-a-passcode
SHORTSMITH_MAX_UPLOAD_MB=500
ASSET_POLICY=any                          # any (default: web search on) | rights_safe (web search off) — decision 5.2
IMAGE_GEN=none                            # none | gemini  (decided in grilling)
GEMINI_API_KEY=only-needed-when-IMAGE_GEN=gemini
