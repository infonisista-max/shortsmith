# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.
# An empty KEY= line means unset: the field falls back to its default (052).

# --- who plans and who transcribes ---------------------------------------------------
PLANNER=claude_code                       # fake | claude_code | api — decision 8.3
SHORTSMITH_SINGLE_OPERATOR=true           # required by PLANNER=claude_code (runs on your own subscription) — decision 11.3
PLANNER_MODEL=claude-sonnet-5             # PLANNER=api only — decision 8.3
ANTHROPIC_API_KEY=                       # needed by PLANNER=api and by RELEVANCE_JUDGE=api (the default)
TRANSCRIBER=groq                          # fake | groq — decision 12.1
TRANSCRIBER_MODEL=whisper-large-v3        # research §6: both approved jobs ran large-v3
TRANSCRIBER_LANGUAGE=hi                   # forced language (the Hinglish-drift fix); auto = let Whisper detect
GROQ_API_KEY=                            # required when TRANSCRIBER=groq

# --- the app ---------------------------------------------------------------------------
SHORTSMITH_PASSCODE=                      # required; the app refuses to start without one — decision 11.2
SHORTSMITH_MAX_UPLOAD_MB=500
MAX_QUEUE=3                               # running + waiting jobs; a further submission is refused — decision 11.2
MAX_JOBS_PER_DAY=10                       # global, counted since midnight IST — decision 11.2
MAX_JOB_MINUTES=30                        # the worker kills the step and fails the job past this — decision 11.2
SHORTSMITH_DATA_DIR=data                  # jobs live under <data dir>/jobs/<job_id>/ — decision 2.2

# --- pictures: the 5.1 ladder --------------------------------------------------------
ASSET_POLICY=any                          # any (default: web search on) | rights_safe (web search off) — decision 5.2
ASSET_SOURCES=owner,web,commons,openverse,pexels,pixabay,generate
                                          # the searched sources in order; owner and generate are the fixed bookends
                                          # (listed for readability, never searched); `fake` names the no-network
                                          # source; an unknown name stops the server — decision 5.1
PEXELS_API_KEY=                          # free; unset → pexels is skipped with a note, not an error — 018
PIXABAY_API_KEY=                         # free; unset → pixabay is skipped with a note, not an error — 018
RELEVANCE_JUDGE=api                       # none | fake | api — the cheap filter above the sources — decision 5.2
RELEVANCE_JUDGE_MODEL=claude-haiku-4-5-20251001
# 020: map markers come from the bundled gazetteer; `nominatim` adds the network
# fallback (one request a second, cached per job under work/geo/). Free, unmetered.
GEOCODER_FALLBACK=none
NOMINATIM_URL=https://nominatim.openstreetmap.org
IMAGE_GEN=none                            # none | fake | gemini — ladder rung 2 — decision 5.5
IMAGE_GEN_MODEL=gemini-2.5-flash-image
IMAGE_GEN_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
GEMINI_API_KEY=                          # required when IMAGE_GEN=gemini

# --- sound -------------------------------------------------------------------------------
FREESOUND_API_KEY=                       # free (freesound.org/apiv2/apply); unset → no runtime audio search,
                                          # a bed under the style's bed_score_threshold leaves the short without one — 024

# --- money ------------------------------------------------------------------------------
PRICES_FILE=prices.yaml                   # copy prices.example.yaml and edit; required once a paid provider is configured — decision 5.6
BUDGET_INR_PER_DAY=500                    # daily cash guard across jobs; the form closes until midnight IST — decision 11.3
# Per-job caps are unset (disabled) on purpose: decision 11.3 derives them from the ledger, not from a guess.
# After the first 10 metered passing jobs, set BUDGET_INR_PER_JOB to the p90 of their cash cost (soft: flags only)
# and BUDGET_INR_HARD above it (hard: the job fails before the next paid call). Nothing is ever degraded for cost.
#BUDGET_INR_PER_JOB=
#BUDGET_INR_HARD=

# --- not a setting: smoke only ---------------------------------------------------------
#SHORTSMITH_SMOKE_KEEP=1                  # keeps the smoke run under work/smoke/ instead of a temp dir — 049